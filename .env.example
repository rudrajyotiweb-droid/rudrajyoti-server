# ─────────────────────────────────────────────────────────────
#  Rudra Jyoti backend — copy to .env and fill in real values
# ─────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development
PORT=5000
# Public URL of THIS API (used for Paytm callback URL and absolute media links)
API_PUBLIC_URL=http://localhost:5000

# Frontends (comma-separated list allowed for CORS)
CLIENT_URL=http://localhost:3123
ADMIN_URL=http://localhost:5174
# Extra CORS origins, comma-separated (optional)
CORS_EXTRA_ORIGINS=

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/rudrajyoti

# ── Auth (generate long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ADMIN_SECRET=
# Lifetimes
JWT_ACCESS_TTL=15m
JWT_ADMIN_TTL=8h
REFRESH_TTL_DAYS=30

# ── OTP via Message Central (VerifyNow) ──────────────────────
# OTP_PROVIDER=messagecentral sends real SMS. OTP_PROVIDER=console logs a fixed dev OTP
# (console is refused when NODE_ENV=production).
OTP_PROVIDER=console
OTP_LENGTH=6
OTP_DEV_CODE=123456
MESSAGE_CENTRAL_CUSTOMER_ID=
# Your Message Central password (plain). It is Base64-encoded automatically.
MESSAGE_CENTRAL_PASSWORD=
MESSAGE_CENTRAL_EMAIL=
MESSAGE_CENTRAL_COUNTRY_CODE=91
# SMS | WHATSAPP
MESSAGE_CENTRAL_FLOW_TYPE=SMS

# ── Payments via Paytm ───────────────────────────────────────
# PAYMENT_PROVIDER=paytm uses Paytm. PAYMENT_PROVIDER=mock completes payments instantly
# for local testing (refused when NODE_ENV=production).
PAYMENT_PROVIDER=mock
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
# staging: https://securegw-stage.paytm.in   production: https://securegw.paytm.in
PAYTM_HOST=https://securegw-stage.paytm.in

# ── Media uploads (stored in MongoDB GridFS) ─────────────────
MAX_IMAGE_MB=8
MAX_VIDEO_MB=80

# ── Seed ─────────────────────────────────────────────────────
# Folder whose images/ and brand/ subfolders are uploaded to the database by `pnpm seed`
SEED_ASSETS_DIR=../client-site/public/assets
# First super-admin created by `pnpm seed`
SEED_ADMIN_EMAIL=admin@rudrajyoti.in
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin

# Log level: fatal | error | warn | info | debug
LOG_LEVEL=info
